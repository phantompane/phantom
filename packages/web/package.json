{
  "name": "@phantompane/web",
  "version": "6.3.0-10",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "portless run --name phantom pnpm run dev:app",
    "dev:app": "vite dev",
    "build": "vite build && tsgo --noEmit",
    "preview": "vite preview",
    "lint": "oxfmt --check . && oxlint .",
    "fix": "oxfmt --write . && oxlint --fix .",
    "typecheck": "tsgo --noEmit",
    "test": "vitest run --root ../.. packages/web/src"
  },
  "dependencies": {
    "@phantompane/server": "workspace:*",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@tanstack/react-query": "^5.101.0",
    "hono": "^4.12.25",
    "lucide-react": "^1.20.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.6",
    "react-resizable-panels": "^4.11.2",
    "react-router": "^7.18.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.1",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "tailwindcss": "4.3.1",
    "typescript": "npm:@typescript/typescript6@^6.0.0",
    "vite": "^8.0.16",
    "vitest": "^4.1.9"
  }
}
