{
  "name": "@phantompane/web",
  "version": "6.3.0-9",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "portless run --name phantom pnpm run dev:app",
    "dev:app": "vite dev",
    "build": "vite build && tsgo --noEmit",
    "preview": "vite preview",
    "lint": "oxfmt --check . && oxlint .",
    "fix": "oxfmt --write . && oxlint --fix .",
    "typecheck": "tsgo --noEmit",
    "test": "vitest run --root ../.. packages/web/src"
  },
  "dependencies": {
    "@phantompane/server": "workspace:*",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@tanstack/react-query": "^5.100.6",
    "hono": "^4.12.18",
    "lucide-react": "^1.14.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-resizable-panels": "^4.11.0",
    "react-router": "^7.15.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.2.4",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "tailwindcss": "4.2.4",
    "typescript": "npm:@typescript/typescript6@^6.0.0",
    "vite": "^8.0.10",
    "vitest": "^4.1.5"
  }
}
