{
  "name": "@phantompane/web",
  "version": "6.3.0-10",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "portless run --name phantom pnpm run dev:app",
    "dev:app": "vite dev",
    "build": "vite build && tsgo --noEmit",
    "deploy": "pnpm run build && wrangler deploy --config wrangler.jsonc",
    "deploy:dry-run": "pnpm run build && wrangler deploy --dry-run --config wrangler.jsonc",
    "preview": "vite preview",
    "lint": "oxfmt --check . && oxlint .",
    "fix": "oxfmt --write . && oxlint --fix .",
    "typecheck": "tsgo --noEmit",
    "test": "vitest run --root ../.. packages/web/src"
  },
  "dependencies": {
    "@phantompane/server": "workspace:*",
    "@radix-ui/react-dropdown-menu": "^2.1.18",
    "@tanstack/react-query": "^5.101.2",
    "hono": "^4.12.27",
    "lucide-react": "^1.22.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-resizable-panels": "^4.12.0",
    "react-router": "^7.18.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.2",
    "@types/node": "^25.9.4",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "tailwindcss": "4.3.2",
    "typescript": "npm:@typescript/typescript6@^6.0.0",
    "vite": "^8.1.0",
    "vitest": "^4.1.9",
    "wrangler": "^4.107.0"
  }
}
