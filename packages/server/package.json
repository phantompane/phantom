{
  "name": "@phantompane/server",
  "version": "6.3.0-10",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "dev": "portless run --name api.phantom pnpm run dev:app",
    "dev:app": "node --no-warnings --experimental-transform-types src/start.ts",
    "build": "tsdown",
    "lint": "oxfmt --check . && oxlint .",
    "fix": "oxfmt --write . && oxlint --fix .",
    "typecheck": "tsgo --noEmit",
    "test": "vitest run --root ../.. packages/server/src"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.14",
    "@phantompane/codex": "workspace:*",
    "@phantompane/core": "workspace:*",
    "@phantompane/git": "workspace:*",
    "@phantompane/state": "workspace:*",
    "hono": "^4.12.25",
    "marked": "^18.0.5",
    "sanitize-html": "^2.17.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.9.4",
    "@types/sanitize-html": "^2.16.1",
    "tsdown": "^0.22.3",
    "typescript": "npm:@typescript/typescript6@^6.0.0",
    "vitest": "^4.1.9"
  }
}
